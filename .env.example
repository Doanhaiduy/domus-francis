# Environment Variables — Lưu Xá Phanxicô
# Copy file này thành .env.local và điền giá trị thực
# ĐỪng commit .env.local lên Git!

# ── SUPABASE (bắt buộc) ──────────────────────────────────────
# Lấy tại: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── CLOUDINARY (fallback upload ảnh - tùy chọn) ─────────────
# Lấy tại: https://cloudinary.com → Settings → Upload → Upload presets
# Tạo 1 preset kiểu "Unsigned" tên gì cũng được
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=luu-xa-unsigned

# ── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Lưu Xá Phanxicô
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
