# Biến môi trường — Lưu Xá Phanxicô (chạy hoàn toàn LOCAL)
# KHÔNG cần điền tay: `pnpm setup:local` tự sinh .env.local với giá trị ngẫu nhiên trên máy này.
# .env.local nằm trong .gitignore — không commit.

# PostgreSQL local (127.0.0.1:54329, binary portable trong node_modules)
PG_SUPERUSER_PASSWORD=<sinh tự động>
LUUXA_API_PASSWORD=<sinh tự động>
DATABASE_URL=postgresql://luuxa_api:<mật khẩu>@127.0.0.1:54329/luuxa   # phải là localhost — app từ chối host khác

# Khóa ký JWT phiên đăng nhập (Ed25519, JWK)
AUTH_JWT_PRIVATE_JWK=<sinh tự động>
AUTH_JWT_PUBLIC_JWK=<sinh tự động>

# Khóa mã hóa dữ liệu cá nhân (CCCD, SĐT phụ huynh) — AES-256-GCM + HMAC blind index, 32 byte base64
PII_KEY_V1=<sinh tự động>
PII_BIDX_KEY=<sinh tự động>

# Thư mục lưu tệp tải lên (thay cho S3/R2)
STORAGE_DIR=.local/storage

# true khi chạy sau HTTPS (cookie __Host-/Secure); để false khi dùng http://localhost
COOKIE_SECURE=false

NEXT_PUBLIC_APP_NAME=Lưu Xá Phanxicô

# --- AI hỗ trợ (tùy chọn; để trống = AI không chạy, mọi thứ vẫn dùng bình thường) ---
# Mặc định dùng Groq; nếu Groq lỗi/hết hạn mức thì tự chuyển sang Gemini (nếu có khóa).
# Khóa chỉ nằm ở đây (không lưu DB, không gửi về trình duyệt). Bật tính năng trong Cài đặt → Trợ lý AI.
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# AI_PROVIDER_ORDER=groq,gemini
# AI_TIMEOUT_MS=20000

# --- Tích hợp nhóm Zalo (tùy chọn) ---
# Bot Token tạo ở https://bot.zaloplatforms.com — chỉ đặt ở biến môi trường máy chủ (Vercel), không lưu CSDL.
# Bật/tắt, mã nhóm (chat_id) và loại tin cấu hình ở Cài đặt → Tích hợp Zalo.
ZALO_BOT_TOKEN=

# --- Supabase (Vercel) ---
# DATABASE_URL phải dùng Transaction pooler (cổng 6543). Cổng 5432 (session mode) dễ lỗi EMAXCONNSESSION khi nhiều hàm serverless cùng chạy;
# ứng dụng tự đổi 5432 -> 6543 cho host *.pooler.supabase.com. Giới hạn kết nối mỗi instance: DB_POOL_MAX (mặc định 3 trên Vercel).
# DB_POOL_MAX=3

# --- Tác vụ hằng ngày (Vercel Cron) ---
# Vercel tự gửi "Authorization: Bearer $CRON_SECRET" khi gọi /api/cron/daily. Đặt một chuỗi ngẫu nhiên dài (vd. 32 ký tự). Thiếu biến này thì tác vụ hằng ngày bị từ chối.
CRON_SECRET=

# --- Địa chỉ công khai của ứng dụng (liên kết trong email, sitemap, thẻ chia sẻ; để trống = suy từ request) ---
# NEXT_PUBLIC_APP_URL=https://domus-francis-production.vercel.app

# --- Thông báo đẩy (Web Push / PWA) — sinh cặp khóa bằng `pnpm env:keys` ---
# Thiếu khóa = không gửi thông báo đẩy (thông báo trong ứng dụng vẫn hoạt động).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (quên mật khẩu, thông báo) qua Resend — https://resend.com ---
# Thiếu RESEND_API_KEY = không gửi email (quên mật khẩu sẽ không có thư). EMAIL_FROM phải thuộc tên miền đã xác minh ở Resend.
RESEND_API_KEY=
EMAIL_FROM=Lưu Xá Phanxicô <no-reply@example.com>
# EMAIL_DEV_LOG=1   # chỉ để phát triển: in nội dung email ra console thay vì gửi

# --- Chống thư rác ở biểu mẫu đăng ký công khai (Cloudflare Turnstile, tùy chọn) ---
# Có cả hai khóa = bật CAPTCHA ở trang /lien-he. Thiếu = chỉ dùng ô bẫy + giới hạn theo IP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Nhận giao dịch ngân hàng tự động (SePay / Casso, tùy chọn) ---
# Chuỗi bí mật ≥ 16 ký tự (vd. `openssl rand -hex 24`). Đặt cùng giá trị làm khóa xác thực của webhook ở SePay/Casso trỏ tới
# https://<tên miền>/api/v1/public/bank-webhook. Thiếu = endpoint trả 404. Thủ quỹ xác nhận ghi thu ở Thu chi → Tổng quan.
BANK_WEBHOOK_SECRET=
